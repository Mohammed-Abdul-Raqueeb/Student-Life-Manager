# ── Database ───────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ connection string. On Vercel, use the *pooled* Neon URL.
#   Neon:  postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   Local: postgres://postgres:postgres@localhost:51214/studentlife?sslmode=disable
#          (start one with `npm run db:dev` — no Docker or cloud account needed)
DATABASE_URL=

# Maximum pooled connections. Leave unset (default 5) for a real PostgreSQL or
# Neon. Set to 1 for the bundled `prisma dev` server, which is PostgreSQL
# compiled to WebAssembly and serves one client at a time.
# DATABASE_POOL_MAX=1

# ── Timezone ───────────────────────────────────────────────────────────────────
# There is nothing to set. The app's calendar is pinned in code — see
# APP_TIME_ZONE in src/lib/date.ts — because Vercel reserves TZ and refuses to
# let it be set. Every "today", countdown and weekday is evaluated in that zone
# no matter what the host's clock says, so this works the same locally, in CI
# and in production.

# ── Authentication ─────────────────────────────────────────────────────────────
# Signs session cookies. Must be at least 32 characters, and must be the SAME
# value across every instance of a deployment — a per-instance value would log
# people out whenever they hit a different one. Generate with:
#   openssl rand -base64 32
# Required in production: the app refuses to boot without it rather than falling
# back to a value that changes on each cold start.
BETTER_AUTH_SECRET=

# The canonical origin, used to build callback URLs and to decide whether
# cookies get the Secure attribute. Leave unset locally (it is inferred) and on
# Vercel (VERCEL_URL is used); set it when the app has a custom domain, e.g.
#   BETTER_AUTH_URL=https://campivo.vercel.app
BETTER_AUTH_URL=
